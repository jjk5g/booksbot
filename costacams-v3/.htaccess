Options -Indexes
DirectoryIndex render-stable.php
RewriteEngine On

# Never expose generated cache files as duplicate public URLs. Internal rewrites
# below still work because THE_REQUEST keeps the visitor's original URL.
RewriteCond %{THE_REQUEST} \s/+cache/ [NC]
RewriteRule ^cache/ - [F,L]

# Serve pre-generated HTML directly for normal GET requests with no query string.
# This bypasses PHP/MySQL completely for almost all visitors.
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{DOCUMENT_ROOT}/cache/home.html -f
RewriteRule ^$ cache/home.html [L]

RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{DOCUMENT_ROOT}/cache/map.html -f
RewriteRule ^map/?$ cache/map.html [L]

RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{DOCUMENT_ROOT}/cache/contact.html -f
RewriteRule ^contact/?$ cache/contact.html [L]

# Friendly aliases can also use the corresponding generated beach page.
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{DOCUMENT_ROOT}/cache/the-spit.html -f
RewriteRule ^spit/?$ cache/the-spit.html [L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{DOCUMENT_ROOT}/cache/surfers-paradise.html -f
RewriteRule ^surfers/?$ cache/surfers-paradise.html [L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{DOCUMENT_ROOT}/cache/mermaid-beach.html -f
RewriteRule ^mermaid/?$ cache/mermaid-beach.html [L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{DOCUMENT_ROOT}/cache/snapper-rocks.html -f
RewriteRule ^snapper/?$ cache/snapper-rocks.html [L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{DOCUMENT_ROOT}/cache/duranbah.html -f
RewriteRule ^(dbah|d-bah)/?$ cache/duranbah.html [L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{DOCUMENT_ROOT}/cache/byron-bay.html -f
RewriteRule ^byron/?$ cache/byron-bay.html [L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{DOCUMENT_ROOT}/cache/the-pass.html -f
RewriteRule ^thepass/?$ cache/the-pass.html [L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{DOCUMENT_ROOT}/cache/byron-main-beach.html -f
RewriteRule ^main-beach-byron/?$ cache/byron-main-beach.html [L]

# Any canonical beach slug with a generated file is served statically.
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{DOCUMENT_ROOT}/cache/$1.html -f
RewriteRule ^([a-z0-9-]+)/?$ cache/$1.html [L]

# Compression for dynamic/fallback responses and generated HTML.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(?:png|jpe?g|webp|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=60, stale-while-revalidate=600"
  </FilesMatch>
</IfModule>

# Dynamic fallbacks. These run only if the static cache is absent or a query
# string requires a fresh response.
RewriteRule ^map/?$ map-clean.php [QSA,L]
RewriteRule ^contact/?$ contact-fast.php [QSA,L]
RewriteRule ^admin/?$ admin.php [QSA,L]

RewriteRule ^spit/?$ render-fast.php?slug=the-spit [QSA,L]
RewriteRule ^surfers/?$ render-fast.php?slug=surfers-paradise [QSA,L]
RewriteRule ^mermaid/?$ render-fast.php?slug=mermaid-beach [QSA,L]
RewriteRule ^snapper/?$ render-fast.php?slug=snapper-rocks [QSA,L]
RewriteRule ^(dbah|d-bah)/?$ render-fast.php?slug=duranbah [QSA,L]
RewriteRule ^byron/?$ render-fast.php?slug=byron-bay [QSA,L]
RewriteRule ^thepass/?$ render-fast.php?slug=the-pass [QSA,L]
RewriteRule ^main-beach-byron/?$ render-fast.php?slug=byron-main-beach [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/?$ render-fast.php?slug=$1 [QSA,L]

# Internal implementation files are never served directly.
<FilesMatch "^(bootstrap|server-config|health|data-refresh|content-ingest|shark-refresh|data-check|page-warm|health-debug)\.php$">
  Require all denied
</FilesMatch>
<Files "schema.sql">
  Require all denied
</Files>
