Options -Indexes
DirectoryIndex app.php
RewriteEngine On

# Compress HTML/JSON/text responses when supported by the host.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Static assets rarely change; let the browser keep them locally.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(?:png|jpe?g|webp|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Utility pages
RewriteRule ^map/?$ map.php [QSA,L]
RewriteRule ^contact/?$ contact.php [QSA,L]
RewriteRule ^admin/?$ admin.php [QSA,L]

# Friendly aliases
RewriteRule ^spit/?$ channel.php?slug=the-spit [QSA,L]
RewriteRule ^surfers/?$ channel.php?slug=surfers-paradise [QSA,L]
RewriteRule ^mermaid/?$ channel.php?slug=mermaid-beach [QSA,L]
RewriteRule ^snapper/?$ channel.php?slug=snapper-rocks [QSA,L]
RewriteRule ^(dbah|d-bah)/?$ channel.php?slug=duranbah [QSA,L]
RewriteRule ^byron/?$ channel.php?slug=byron-bay [QSA,L]
RewriteRule ^thepass/?$ channel.php?slug=the-pass [QSA,L]
RewriteRule ^main-beach-byron/?$ channel.php?slug=byron-main-beach [QSA,L]

# Dynamic beach pages
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/?$ channel.php?slug=$1 [QSA,L]

# Internal implementation files are never served directly
<FilesMatch "^(bootstrap|server-config|health|data-refresh|content-ingest|shark-refresh|data-check)\.php$">
  Require all denied
</FilesMatch>
<Files "schema.sql">
  Require all denied
</Files>
